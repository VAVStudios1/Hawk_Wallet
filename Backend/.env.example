SECRET_KEY=change-me-generate-a-new-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Team invite links become <base>?ref=<code>; leave empty until the app domain exists
REFERRAL_LINK_BASE_URL=

# OTP settings (development mode - console delivery, no SMS provider yet)
SMS_PROVIDER=console
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# App updates: public https:// origin the APK download URL is built on (empty = no update offered)
APP_RELEASE_DOWNLOAD_BASE_URL=
APP_RELEASE_MAX_APK_MB=150
# Reject API requests that send no X-App-Version header (enable once all shipped apps send it)
APP_VERSION_HEADER_REQUIRED=False
