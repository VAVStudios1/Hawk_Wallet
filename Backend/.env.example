# Copy to .env and fill in. Never commit .env or put real secrets in this file.

# Django signing key - generate your own, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-new-secret-key
# True only for local development; must be False in any deployed environment
DEBUG=True
# Comma-separated hosts this server answers to (10.0.2.2 = Android emulator)
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Team invite links become <base>?ref=<code>; leave empty until the app domain exists
REFERRAL_LINK_BASE_URL=

# OTP SMS delivery: console (local development only, needs DEBUG=True) or 2factor.
# OTP length, expiry, attempts and send limits are fixed in config/settings.py.
SMS_PROVIDER=console
# 2Factor.in API key - required when SMS_PROVIDER=2factor. Real key only in .env.
TWOFACTOR_API_KEY=
# Approved OTP template name from the 2Factor dashboard (empty = account default)
TWOFACTOR_OTP_TEMPLATE=
# 2Factor API base URL (must be https://)
TWOFACTOR_BASE_URL=https://2factor.in/API/V1
# Seconds to wait for 2Factor before treating the send as uncertain
TWOFACTOR_TIMEOUT_SECONDS=10

# App updates: public https:// origin the APK download URL is built on (empty = no update offered)
APP_RELEASE_DOWNLOAD_BASE_URL=
# Largest APK accepted for upload, in MB
APP_RELEASE_MAX_APK_MB=150
# Reject API requests that send no X-App-Version header (enable once all shipped apps send it)
APP_VERSION_HEADER_REQUIRED=False
